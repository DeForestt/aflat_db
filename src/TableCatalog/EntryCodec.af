.needs <std>
import TableSchema, ColumnSchema from "../Schemas";
import TableCatalogEntry from "../TableCatalog";
import {fromTypeTag} from "../Schemas/Types" under db_type;
import Error from "Utils/Error";
import vector from "Collections/Vector";
import uni_string from "uni_string";
import IndexMetadata, IndexSchema from "../Index";

export fn encodedSize(
    immutable TableCatalogEntry entry
) -> int {
    mutable int size = 0;

    size = size + 4;                  // table name length
    size = size + entry.name.len();   // table name
    size = size + 8;                  // first page
    size = size + 4;                  // column count

    immutable let schema = entry.schema.view();
    foreach column in schema.columns {
        size = size + 4;                          // column name length
        size = size + column.name.len();   // column name
        size = size + 4;                          // type tag
        size = size + 1;                          // nullable
    };

    size = size + 4;                  // index count

    foreach index in entry.indexes {
      immutable let index_schema = index.getSchema();
      size = size + 4 + index_schema.name.len(); // index name
      size = size + 4 + 1 + 8;          // column, unique, root page
    };

    return size;
};

export fn encode(immutable TableCatalogEntry schema, mutable adr cursor) -> int! {
  let start = cursor;
  let table_name_length = schema.name.len();
  
  af_memcpy(cursor, ?table_name_length, 4);
  cursor = cursor + 4;
  
  // now we copy the actual name
  af_memcpy(cursor, schema.name.cstr(), table_name_length);

  cursor = cursor + table_name_length;

  // copy the first page id
  let first_page = schema.firstPage;
  af_memcpy(cursor, ?first_page, 8);
  cursor = cursor + 8;

  // copy the column count;
  immutable let table_schema = schema.schema.view();
  let column_count = table_schema.columns.count();
  af_memcpy(cursor, ?column_count, 4);
  cursor = cursor + 4;
  
  // now for the columns
  foreach column in table_schema.columns {
    let column_name_length = column.name.len();
    af_memcpy(cursor, ?column_name_length, 4);
    cursor = cursor + 4;

    af_memcpy(cursor, column.name.cstr(), column_name_length);
    cursor = cursor + column_name_length;

    let type_tag = column.type.toTypeTag();
    af_memcpy(cursor, ?type_tag, 4);
    cursor = cursor + 4;

    let nullable = column.nullable;
    af_memcpy(cursor, ?nullable, 1);
    cursor = cursor + 1;
  };
  
  let index_count = schema.indexes.count();
  af_memcpy(cursor, ?index_count, 4);
  cursor = cursor + 4;

  foreach index in schema.indexes {
    immutable let index_schema = index.getSchema();
    let name_length = index_schema.name.len();
    af_memcpy(cursor, ?name_length, 4);
    cursor = cursor + 4;
    af_memcpy(cursor, index_schema.name.cstr(), name_length);
    cursor = cursor + name_length;

    let column = index_schema.column;
    af_memcpy(cursor, ?column, 4);
    cursor = cursor + 4;
    let is_unique = index_schema._unique;
    af_memcpy(cursor, ?is_unique, 1);
    cursor = cursor + 1;
    let root_page = index.rootPage;
    af_memcpy(cursor, ?root_page, 8);
    cursor = cursor + 8;
  };

  // added the 0 here to force it to be treated as a `number` which is valid as an int return.
  return 0 + cursor - start;
};

export fn decode(immutable adr bytes, int size) -> TableCatalogEntry! {
  if size < 4 {
    return new Error("Truncated table name length");
  };

  mutable adr cursor = bytes;
  mutable int remaining = size;

  int table_name_length = 0;
  af_memcpy(?table_name_length, cursor, 4);
  cursor = cursor + 4;
  remaining = remaining - 4;

  if (table_name_length < 0) | (remaining < table_name_length) {
    return new Error("Truncated table name");
  };

  const adr table_name_bytes = af_malloc(table_name_length + 1);
  af_memcpy(table_name_bytes, cursor, table_name_length);
  (table_name_bytes + table_name_length) =: '\0';
  let table_name = new uni_string(table_name_bytes);
  af_free(table_name_bytes);
  cursor = cursor + table_name_length;
  remaining = remaining - table_name_length;

  if remaining < 8 {
    return new Error("Truncated first page ID");
  };

  long first_page = 0;
  af_memcpy(?first_page, cursor, 8);
  cursor = cursor + 8;
  remaining = remaining - 8;

  if remaining < 4 {
    return new Error("Truncated column count");
  };

  int column_count = 0;
  af_memcpy(?column_count, cursor, 4);
  cursor = cursor + 4;
  remaining = remaining - 4;

  // Every column requires at least a name length, type tag, and null flag.
  if (column_count < 0) | (column_count > remaining / 9) {
    return new Error("Invalid column count");
  };

  let columns = new vector::<ColumnSchema>(column_count);
  for int i = 0; i < column_count; i++ {
    if remaining < 4 {
      return new Error("Truncated column name length");
    };

    int column_name_length = 0;
    af_memcpy(?column_name_length, cursor, 4);
    cursor = cursor + 4;
    remaining = remaining - 4;

    if (column_name_length < 0) | (remaining < column_name_length) {
      return new Error("Truncated column name");
    };

    const adr column_name_bytes = af_malloc(column_name_length + 1);
    af_memcpy(column_name_bytes, cursor, column_name_length);
    (column_name_bytes + column_name_length) =: '\0';
    let column_name = new uni_string(column_name_bytes);
    af_free(column_name_bytes);
    cursor = cursor + column_name_length;
    remaining = remaining - column_name_length;

    if remaining < 4 {
      return new Error("Truncated column type tag");
    };

    int type_tag = 0;
    af_memcpy(?type_tag, cursor, 4);
    cursor = cursor + 4;
    remaining = remaining - 4;
    let column_type = db_type.fromTypeTag(type_tag)!;

    if remaining < 1 {
      return new Error("Truncated nullable byte");
    };

    bool nullable = false;
    af_memcpy(?nullable, cursor, 1);
    cursor = cursor + 1;
    remaining = remaining - 1;

    columns.push_back(new ColumnSchema(
      $column_name, $column_type, nullable));
  };

  let indexes = new vector::<IndexMetadata>();
  let index_schemas = new vector::<IndexSchema>();
  // Older entries end after the columns and have no index metadata.
  if remaining != 0 {
    if remaining < 4 {
      return new Error("Truncated index count");
    };
    int index_count = 0;
    af_memcpy(?index_count, cursor, 4);
    cursor = cursor + 4;
    remaining = remaining - 4;
    if (index_count < 0) | (index_count > remaining / 17) {
      return new Error("Invalid index count");
    };

    for int i = 0; i < index_count; i++ {
      if remaining < 4 {
        return new Error("Truncated index name length");
      };
      int name_length = 0;
      af_memcpy(?name_length, cursor, 4);
      cursor = cursor + 4;
      remaining = remaining - 4;
      if (name_length < 0) | (name_length > remaining - 13) {
        return new Error("Truncated index metadata");
      };

      let name_bytes = af_malloc(name_length + 1);
      af_memcpy(name_bytes, cursor, name_length);
      (name_bytes + name_length) =: '\0';
      let index_name = new uni_string(name_bytes);
      af_free(name_bytes);
      cursor = cursor + name_length;
      remaining = remaining - name_length;

      int column = 0;
      af_memcpy(?column, cursor, 4);
      cursor = cursor + 4;
      int unique_flag = 0;
      af_memcpy(?unique_flag, cursor, 1);
      cursor = cursor + 1;
      long root_page = 0;
      af_memcpy(?root_page, cursor, 8);
      cursor = cursor + 8;
      remaining = remaining - 13;
      if (column < 0) | (column >= column_count) {
        return new Error("Invalid index column");
      };
      if (unique_flag != 0) & (unique_flag != 1) {
        return new Error("Invalid index unique flag");
      };
      let is_unique = unique_flag == 1;
      index_schemas.push_back(new IndexSchema(
        new uni_string(index_name.cstr()), column, is_unique));
      indexes.push_back(new IndexMetadata(
        new IndexSchema($index_name, column, is_unique), root_page));
    };
  };

  if remaining != 0 {
    return new Error("Trailing table catalog bytes");
  };

  let schema = new TableSchema(
    new uni_string(table_name.cstr()), $columns, $index_schemas);
  let entry = new TableCatalogEntry(
    new uni_string(table_name.cstr()), first_page, $schema,
    $indexes);
  return entry;

};
