.needs <std>
import uni_string from "uni_string";
import Error from "Utils/Error";
import {resultWrapper} from "Utils/result" under res;

union DBValue {
    Null,
    Int(int),
    Long(long),
    Float(float),
    Bool(bool),
    Text(uni_string)

    safe fn clone() -> DBValue {
      match my {
        Null => return new DBValue->Null(),
        Int(value) => return new DBValue->Int(value),
        Long(value) => return new DBValue->Long(value),
        Float(value) => return new DBValue->Float(value),
        Bool(value) => return new DBValue->Bool(value),
        Text(value) => return new DBValue->Text(value.clone()),
      };
    };

    fn isNull() -> bool {
      match my {
        Null => return true,
        _ => false,
      };
    };

    fn asInt() -> int! {
      match my {
        Int(v) => return v,
        _ => return new Error("DBValue is not an int"),
      };
    };

    fn asLong() -> long! {
      match my {
        Long(v) => return v,
        _ => return new Error("DBValue is not a long"),
      };
    };

    fn asFloat() -> float! {
      match my {
        Float(v) => return v,
        _ => return new Error("DBValue is not a float"),
      };
    };

    fn asBool() -> bool! {
      match my {
        Bool(v) => return v,
        _ => return new Error("DBValue is not a bool"),
      };
    };

    fn asText() -> uni_string! {
      match my {
        Text(v) => return v,
        _ => return new Error("DBValue is not text"),
      };
    };

    private fn compareInt(immutable DBValue other) -> int! {
      match other {
        Int(other_value) => {
          match my {
            Int(value) => {
              if value < other_value return -1;
              if value > other_value return 1;
              return 0;
            },
            _ => return new Error("DBValue is not an int"),
          };
        },
        _ => return new Error("DBValue is not an int"),
      };
    };

    private fn compareLong(immutable DBValue other) -> int! {
      match other {
        Long(other_value) => {
          match my {
            Long(value) => {
              if value < other_value return -1;
              if value > other_value return 1;
              return 0;
            },
            _ => return new Error("DBValue is not a long"),
          };
        },
        _ => return new Error("DBValue is not a long"),
      };
    };

    private fn compareFloat(immutable DBValue other) -> int! {
      match other {
        Float(other_value) => {
          match my {
            Float(value) => {
              if value < other_value return -1;
              if value > other_value return 1;
              return 0;
            },
            _ => return new Error("DBValue is not a float"),
          };
        },
        _ => return new Error("DBValue is not a float"),
      };
    };

    private fn compareBool(immutable DBValue other) -> int! {
      match other {
        Bool(other_value) => {
          match my {
            Bool(value) => {
              if value == other_value return 0;
              if !value return -1;
              return 1;
            },
            _ => return new Error("DBValue is not a bool"),
          };
        },
        _ => return new Error("DBValue is not a bool"),
      };
    };

    private fn compareText(immutable DBValue other) -> int! {
      match other {
        Text(other_value) => {
          match my {
            Text(value) => {
              const int shared_length = if value.len() < other_value.len()
                value.len()
              else
                other_value.len();

              for mutable int i = 0; i < shared_length; i = i + 1 {
                if value.at(i) < other_value.at(i) return -1;
                if value.at(i) > other_value.at(i) return 1;
              };

              if value.len() < other_value.len() return -1;
              if value.len() > other_value.len() return 1;
              return 0;
            },
            _ => return new Error("DBValue is not text"),
          };
        },
        _ => return new Error("DBValue is not text"),
      };
    };

    fn compare(immutable DBValue other) -> int! {
      match my {
        Null => {
          if other.isNull() return 0;
          return new Error("Cannot compare DBValues of different types");
        },
        Int() => return my.compareInt(other),
        Long() => return my.compareLong(other),
        Float() => return my.compareFloat(other),
        Bool() => return my.compareBool(other),
        Text() => return my.compareText(other),
      };
    };
};

export fn Null() -> DBValue {
  return new DBValue->Null();
};

export fn Int(int value) -> DBValue {
  return new DBValue->Int(value);
};

export fn Long(long value) -> DBValue {
  return new DBValue->Long(value);
};

export fn Float(float value) -> DBValue {
  return new DBValue->Float(value);
};

export fn Bool(bool value) -> DBValue {
  return new DBValue->Bool(value);
};

export fn Text(uni_string &&value) -> DBValue {
  return new DBValue->Text($value);
};
