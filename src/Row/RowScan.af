.needs <std>

import TableSchema from "../Schemas";
import view from "Memory";
import TableScan from "../TableHeap/TableScan";
import {loan} from "Memory" under box;
import {decode} from "../Row/Codec" under row_codec;
import {None} from "Utils/option" under opt;
import TableRecord from "../Table/TableRecord";

unique class RowScan {
    private TableScan scan = $scan;
    private view::<TableSchema> schema = box.loan(schema);

    fn init(
        TableScan &&scan,
        immutable TableSchema schema
    ) -> Self {
        return my;
    };

    async fn next() -> TableRecord? {
        let next = await my.scan.next();

        if next.isNone() {
            return opt.None::<TableRecord>();
        };

        let heap_record = next.expect("expected heap record");

        // Preserve the locator before decoding the record. Decoding borrows
        // from heap_record, and reading its unique ID afterwards can leave us
        // copying from an object whose lifetime has already ended.
        const long page_id = heap_record.id.pageId;
        const int slot_id = heap_record.id.slotId;

        let schema = my.schema.view();

        let row = row_codec.decode(
            schema,
            heap_record.record
        );

        if row.isErr() {
          return;
        };

        let row = row.expect("expected row");
        
        // Keep the locator as values. A nested unique RecordId would borrow
        // from the temporary HeapRecord and become invalid after this call.
        let tr = new TableRecord(page_id, slot_id, $row);

        return tr;
    };
};
